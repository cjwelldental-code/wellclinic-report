# ---------------------------------------------------------------------------
# 구글 시트 (데이터 저장소)
# 스프레드시트 주소 .../spreadsheets/d/<이 부분>/edit 를 넣는다
# ---------------------------------------------------------------------------
GOOGLE_SHEET_ID=

# ---------------------------------------------------------------------------
# 구글 서비스 계정 (시트 + 캘린더 공용)
# GOOGLE_PRIVATE_KEY 는 JSON 키 파일의 private_key 값을 큰따옴표로 감싸서 그대로 붙여넣는다.
# 줄바꿈이 \n 문자로 들어가 있어도 앱이 알아서 처리한다.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# 구글 캘린더 — 이름=캘린더ID 를 쉼표로 잇는다
# ---------------------------------------------------------------------------
# 캘린더 ID는 구글 캘린더 > 해당 캘린더 설정 > "캘린더 통합" 에서 확인한다.
# 기본 캘린더면 계정 이메일 그대로, 별도로 만든 캘린더면 @group.calendar.google.com 형태다.
GOOGLE_CALENDAR_IDS="웰치과=여기에_캘린더_ID"

# ---------------------------------------------------------------------------
# 로그인
# 사람 명단은 환경변수가 아니라 src/lib/members.ts 의 ROSTER 에 있다.
# 비밀번호만 여기서 정한다.
# ---------------------------------------------------------------------------
TEAM_PASSWORD=
SESSION_SECRET=

# ---------------------------------------------------------------------------
# 매일 아침 자동 수집이 데이터를 보낼 때 쓰는 토큰
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------------
INGEST_TOKEN=

# ---------------------------------------------------------------------------
# 보고 글 AI 정리 (선택)
# 구글 AI Studio(aistudio.google.com) 에서 발급받은 키를 넣는다.
# 비워 두면 화면에서 'AI로 정리' 버튼이 아예 숨겨지고 나머지는 그대로 돌아간다.
#
# GEMINI_MODEL 은 보통 비워 둔다. 기본값은 gemini-2.5-flash-lite 인데,
# AI콜 모니터링 시스템이 쓰는 Flash 계열과 무료 한도를 나눠 쓰지 않으려고 고른 것이다.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
